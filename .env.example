# Django
SECRET_KEY=your-django-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Database
DATABASE_URL=postgresql://postgres:postgres@db:5432/safety_reporter
DB_NAME=safety_reporter
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432
DB_EXTERNAL_PORT=5433

# SendGrid — Django reads EMAIL_HOST_PASSWORD or SENDGRID_API_KEY (see config/settings.py).
# On Render free tier, outbound SMTP is blocked: set USE_SENDGRID_API=True (uses HTTPS API).
SENDGRID_API_KEY=your-sendgrid-api-key
DEFAULT_FROM_EMAIL=noreply@yourdomain.com
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
USE_SENDGRID_API=False

# Ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3
AI_CLASSIFICATION_ENABLED=True

# Media
MEDIA_ROOT=/app/media
